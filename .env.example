# LASSI WASSI — Production & Local Environment Variables

# The canonical production base URL (used for dynamic sitemap.xml, robots.txt, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://lassiwassi.in

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# If left blank or absent, analytics scripts remain safely disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console Verification Token (meta tag content)
# Obtained from Search Console > HTML Tag verification method
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools Verification Token (msvalidate.01 content)
NEXT_PUBLIC_BING_VERIFICATION=
